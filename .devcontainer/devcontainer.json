{
  "name": "proxspray",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Work as the image's non-root user instead of root.
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  // Dev Containers forwards the host ssh-agent and copies ~/.gitconfig
  // automatically, so no manual SSH_AUTH_SOCK mount is needed.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["redhat.ansible"],
      "settings": {
        "files.associations": {
          "**/roles/**/*.yml": "ansible",
          "**/playbooks/*.yml": "ansible",
          "setup.yml": "ansible"
        },
        "ansible.validation.lint.enabled": true
      }
    }
  }
}
