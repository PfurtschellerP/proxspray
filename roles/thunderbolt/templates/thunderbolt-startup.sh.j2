#!/bin/bash
{{ ansible_managed | comment }}

echo "$(date): Starting Thunderbolt interface configuration"

# Wait up to 30 seconds for interfaces to appear
for i in {1..30}; do
    if ip link show en05 &>/dev/null && ip link show en06 &>/dev/null; then
        echo "$(date): Thunderbolt interfaces found"
        break
    fi
    echo "$(date): Waiting for Thunderbolt interfaces... ($i/30)"
    sleep 1
done

# Configure interfaces if they exist
if ip link show en05 &>/dev/null; then
    /usr/local/bin/thunderbolt-en05.sh
    echo "$(date): en05 configured"
fi

if ip link show en06 &>/dev/null; then
    /usr/local/bin/thunderbolt-en06.sh
    echo "$(date): en06 configured"
fi

echo "$(date): Thunderbolt configuration completed"
