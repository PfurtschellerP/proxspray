{{ ansible_managed | comment }}
# Bring up Thunderbolt interfaces whenever they appear (boot, cable replug).
# Sorted after 80-net-setup-link.rules, so NAME already holds the final name.
{% for interface in thunderbolt_devices | sort %}
ACTION=="add|move", SUBSYSTEM=="net", NAME=="{{ interface }}", TAG+="systemd", ENV{SYSTEMD_WANTS}+="proxspray-thunderbolt-ifup@{{ interface }}.service"
{% endfor %}
