#!/bin/bash
{{ ansible_managed | comment }}

echo "$(date): {{ interface }} bringup triggered"

for i in {1..5}; do
    if ip link set {{ interface }} up mtu 65520 2>/dev/null; then
        echo "$(date): {{ interface }} up successful on attempt $i"
        break
    else
        echo "$(date): Attempt $i failed, retrying in 3 seconds..."
        sleep 3
    fi
done
EOF
